# Copy this file to .github/workflows/post-codefreeze-gate.yml in your consumer repo.
# No configuration needed — all defaults are in the central workflow.
# Do NOT rename the job key 'post-codefreeze-gate' — the ruleset depends on this exact name.

name: Post-Codefreeze Gatekeeper

on:
  pull_request:
    types: [opened, synchronize, reopened, edited, labeled]
    branches:
      - 'rhoai-[0-9].[0-9]'
      - 'rhoai-[0-9].[0-9]-ea.[0-9]'

jobs:
  post-codefreeze-gate:
    if: github.event.action != 'labeled' || github.event.label.name == 'run-gatekeeper'
    uses: red-hat-data-services/devops-shared-resources/.github/workflows/post-codefreeze-gate-logic.yml@main
    secrets: inherit
